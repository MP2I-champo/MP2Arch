#!/usr/bin/env bash

set -e
source "$1"

echo "Initializing EFI part (FAT 32)..."
mkfs.fat -F32 "${EFI_PART}"

echo "Initializing Swap part..."
mkswap "${SWAP_PART}"

echo "Initializing root part (ext4)..."
mkfs.ext4 -F  "${ROOT_PART}"

echo "Initializing home part (ext4)..."
mkfs.ext4 -F  "${HOME_PART}"

echo "Mounting filesystem..."
mount "${ROOT_PART}" /mnt

mount --mkdir "${EFI_PART}" /mnt/boot
mount --mkdir "${HOME_PART}" /mnt/home

swapon "${SWAP_PART}"

echo "Updating mirror list... (may take time)"
reflector --country 'France,Germany' --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist

mkdir -p /mnt/etc
cp /root/pacman.conf /mnt/etc/pacman.conf

echo "Bootsrapping in newly created env..."
pacstrap -K /mnt base base-devel linux linux-firmware vim grub efibootmgr iwd sudo zsh git intel-ucode amd-ucode openssh

echo "Creating permanent fstab..."
genfstab -U /mnt >> /mnt/etc/fstab
