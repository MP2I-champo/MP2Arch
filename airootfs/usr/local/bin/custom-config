#!/usr/bin/env bash

USER_NAME=$1

echo "Installing some things..."
pacman -Sy --noconfirm
pacman -S --noconfirm hyprland hyprshot hyprpolkitagent swaybg \
  xdg-desktop-portal xdg-desktop-portal-hyprland xorg-xwayland qt6-wayland qt5-wayland \
  zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search \
  pipewire wireplumber pipewire-audio pipewire-pulse pipewire-jack wiremix \
  ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji noto-fonts-cjk \
  bluez bluez-utils bluetui impala \
  brightnessctl reflector nftables \
  starship alacritty fastfetch \
  yazi helix firefox btop \
  waybar fuzzel matugen \
  ly 

echo "Setting up ly"
mkdir -p /etc/ly
cat << 'EOF' > /etc/ly/config.ini
animation = gameoflife

animation_frame_delay = 5
animation_timeout_sec = 120

asterisk = *
auth_fails = 5

battery_id = null

auto_login_service = ly-autologin
auto_login_session = null
auto_login_user = null

bg = 0x00000000

bigclock = en
bigclock_12hr = false
bigclock_seconds = false

blank_box = true
border_fg = 0x00FFFFFF

box_title = null

brightness_down_cmd = /usr/bin/brightnessctl -q -n s 10%-
brightness_down_key = F5

brightness_up_cmd = /usr/bin/brightnessctl -q -n s +10%
brightness_up_key = F6

clear_password = true

clock = null

custom_bind_width = null

custom_sessions = /etc/ly/custom-sessions

default_input = login

edge_margin = 0

error_bg = 0x00000000

error_fg = 0x01FF0000

fg = 0x00FFFFFF

full_color = true

gameoflife_entropy_interval = 10
gameoflife_fg = 0x007DCFFF
gameoflife_frame_delay = 6
gameoflife_initial_density = 0.4

hibernate_cmd = null
hibernate_key = F4

hide_borders = false
hide_key_hints = false

hide_keyboard_locks = false

hide_version_string = true

inactivity_cmd = null
inactivity_delay = 0

initial_info_text = null

input_len = 34

lang = en

login_cmd = null
login_defs_path = /etc/login.defs

logout_cmd = null

ly_log = /var/log/ly.log

margin_box_h = 2

margin_box_v = 1

numlock = true

path = /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

restart_cmd = /sbin/shutdown -r now

restart_key = F2

save = true

service_name = ly

session_log = .local/state/ly-session.log

setup_cmd = /etc/ly/setup.sh

shell = true

show_password_key = F7

show_tty = false

shutdown_cmd = /sbin/shutdown -a now

shutdown_key = F1

sleep_cmd = null

sleep_key = F3

start_cmd = /etc/ly/startup.sh

text_in_center = false

vi_default_mode = normal

vi_mode = false

waylandsessions = /usr/share/wayland-sessions

x_cmd = /usr/bin/X
x_vt = null
xauth_cmd = /usr/bin/xauth
xinitrc = ~/.xinitrc
xsessions = /usr/share/xsessions
EOF

cat << 'EOF' > /etc/nftables.conf
#!/usr/bin/nft -f

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iif "lo" accept

        ct state established,related accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
EOF

mkdir -p /etc/systemd/journald.conf.d
cat << 'EOF' > /etc/systemd/journald.conf.d/00-mem-cap.conf
[Journal]
SystemMaxUse=50M
RuntimeMaxUse=16M
EOF

nft -f /etc/nftables.conf
systemctl enable nftables.service

systemctl disable getty@tty2.service
systemctl enable ly@tty2.service

systemctl enable bluetooth.service

echo "Installing paru..."
git clone https://aur.archlinux.org/paru.git
chown -R "$USER_NAME":"$USER_NAME" paru
(cd paru && sudo -u "$USER_NAME" makepkg -si --noconfirm)
rm -rf paru

echo "Moving user config into the right dir..."
mkdir -p /home/"$USER_NAME"/.config
cp -r /root/config/. /home/"$USER_NAME"/.config/

mkdir -p /home/"$USER_NAME"/.local
cp -r /root/local/. /home/"$USER_NAME"/.local/

cp /root/zshrc /home/"$USER_NAME"/.zshrc

mkdir -p /usr/local/bin
cp /root/random_wallpaper /usr/local/bin/
chmod +x /usr/local/bin/random_wallpaper

mkdir -p /home/"$USER_NAME"/wallpapers
cp -r /root/wallpapers/. /home/"$USER_NAME"/wallpapers/

echo "Granting permissions on files to $USER_NAME"

chown -R "$USER_NAME":"$USER_NAME" /home/"$USER_NAME"/

sudo -u "$USER_NAME" fc-cache -fv
sudo -u "$USER_NAME" matugen image /home/"$USER_NAME"/wallpapers/2.jpg

echo "Setting up grub theme..."
mkdir -p /boot/grub/themes/mp2i
cp /root/grub-config/grub /etc/default/
cp -r /root/grub-config/mp2i/. /boot/grub/themes/mp2i/

while true; do
  read -r -p "Install essential dev tools for MP2I (C compiler and opam) (RECOMMENDED) (y/n): " DEV_TOOLS
  if [[ "$DEV_TOOLS" = "y" ]]; then
    pacman -S --noconfirm clang lldb opam rsync
    sudo -u "$USER_NAME" opam init -a --disable-sandboxing
    sudo -u "$USER_NAME" opam install utop ocaml-lsp-server --yes
    echo "Dev tools installed."
    break
  elif [[ "$DEV_TOOLS" = "n" ]]; then
    echo "Skipped installing dev tools."
    break
  else
    echo "INVALID: invalid, type y or n."
  fi
done


while true; do
  read -r -p "Install LaTeX tools (math language to write documents) (these packages are quite HEAVY, the installation will take some time if you have a bad internet connection) (y/n): " LATEX_TOOLS
  if [[ "$LATEX_TOOLS" = "y" ]]; then
    pacman -S --noconfirm texstudio texlive-basic texlive-latex texlive-latexrecommended texlive-latexextra texlive-fontsrecommended texlive-mathscience texlive-pictures texlive-langfrench
    echo "LaTeX tools installed."
    break
  elif [[ "$LATEX_TOOLS" = "n" ]]; then
    echo "Skipped installing LaTeX tools."
    break
  else
    echo "INVALID: invalid, type y or n."
  fi
done

while true; do
  read -r -p "Install Typst tools (another math language to write documents) (y/n): " LATEX_TOOLS
  if [[ "$LATEX_TOOLS" = "y" ]]; then
    pacman -S --noconfirm typst
    echo "Typst tools installed."
    break
  elif [[ "$LATEX_TOOLS" = "n" ]]; then
    echo "Skipped installing Typst tools."
    break
  else
    echo "INVALID: invalid, type y or n."
  fi
done
