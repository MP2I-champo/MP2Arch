{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 15,

    "modules-left": [
        "cpu",
        "memory",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "custom/bluetooth",
        "wireplumber",
        "battery"
    ],

    "cpu": {
        "interval": 2,
        "format": "  {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": "  {used:0.1f}G"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "○"
        },
        "persistent-workspaces": {
            "*": 5
        },
    },

    "clock": {
        "interval": 60,
        "format": "{:%H:%M  |  %A, %b %d}",
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format-wifi": "󰤨  {essid}",
        "format-disconnected": "󰤨  Offline",
        "on-click": "alacritty -e impala",
        "tooltip": false
    },

    "custom/bluetooth": {
        "format": "󰂯 Bt",
        "on-click": "alacritty -e bluetui",
        "tooltip": false
    },

    "wireplumber": {
        "format": "  {volume}%",
        "format-muted": "  Muted",
        "on-click": "alacritty -e wiremix",
        "tooltip": false
    },

    "battery": {
        "interval": 20,
        "format": "{icon} {capacity}%",
        "format-charging": "{icon} {capacity}% ",
        "format-plugged": "{icon} {capacity}% ",
        "format-icons": ["","","","" ,""],
        "tooltip": false
    }
}
